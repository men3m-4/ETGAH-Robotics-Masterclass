      <geometry>
        <mesh filename="package://ma_robot_description/meshes/ma_robot/zed2_camera_link.dae" scale="1 1 1"/>
      </geometry>
      <material name="PA_11_Nylon_HP_11_30_with_EOS_P_396_3D_Printer"/>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://ma_robot_description/meshes/ma_robot/zed2_camera_link_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <link name="rplidar_s2_link">
    <inertial>
      <origin xyz="-0.595013 0.532942 0.012880" rpy="0 0 0"/>
      <mass value="0.203764"/>
      <inertia ixx="1.351079e-04" ixy="-7.653496e-09" ixz="1.410544e-08"
               iyy="1.362177e-04" iyz="3.930765e-08" izz="2.370283e-04"/>
    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://ma_robot_description/meshes/ma_robot/rplidar_s2_link.dae" scale="1 1 1"/>
      </geometry>
