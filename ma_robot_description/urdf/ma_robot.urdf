    <collision>
      <origin xyz="0.020000 -0.020000 0.043000" rpy="-1.570796 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://ma_robot_description/meshes/rear_left_wheel_link/Part2_2_Mirror_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="Rigid_1" type="fixed">
    <parent link="base_link"/>
    <child link="zed2_camera_link"/>
    <origin xyz="0.145000 -0.062500 -0.007371" rpy="0.000000 0.000000 -1.570796"/>
  </joint>

  <joint name="Rigid_2" type="fixed">
    <parent link="base_link"/>
    <child link="rplidar_s2_link"/>
    <origin xyz="-0.433747 -0.657506 0.046815" rpy="0.000000 0.000000 -1.570796"/>
  </joint>

  <joint name="Revolute_5" type="continuous">
    <parent link="base_link"/>
    <child link="Part2_1"/>
    <origin xyz="0.260000 0.000000 0.000000" rpy="-1.570796 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Revolute_6" type="continuous">
    <parent link="base_link"/>
    <child link="Part2_2"/>
    <origin xyz="-0.040000 -0.362000 0.040000" rpy="1.570796 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Revolute_8" type="continuous">
    <parent link="base_link"/>
    <child link="Part2_1_Mirror"/>
    <origin xyz="0.260000 -0.362000 0.040000" rpy="1.570796 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="Revolute_9" type="continuous">
    <parent link="base_link"/>
    <child link="Part2_2_Mirror"/>
    <origin xyz="-0.040000 0.026000 0.000000" rpy="-1.570796 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <!-- ROS 2 control: generated generic system -->
  <ros2_control name="ma_robot_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/ma_robot_system/cmd</param>
      <param name="state_topic">sim/ma_robot_system/state</param>
    </hardware>

    <joint name="Revolute_5">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Revolute_6">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Revolute_8">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Revolute_9">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>