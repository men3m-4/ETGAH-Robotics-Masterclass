<?xml version="1.0"?>
<robot name="ma_robot">

  <!-- Materials -->
  <material name="PA_11_Nylon_HP_11_30_with_EOS_P_396_3D_Printer">
    <color rgba="0.247 0.247 0.247 1.0"/>
  </material>
  <material name="Steel">
    <color rgba="1.000 1.000 1.000 1.0"/>
  </material>
  <material name="Acetal_Resin_Black">
    <color rgba="0.098 0.098 0.098 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0.041574 -0.062494 0.024420" rpy="0 0 0"/>
      <mass value="2.899152"/>
      <inertia ixx="7.973742e-03" ixy="9.036729e-07" ixz="2.781740e-04"
               iyy="1.379462e-02" iyz="-4.481306e-07" izz="2.052761e-02"/>
    </inertial>
    <collision>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <geometry>
        <mesh filename="package://ma_robot_description/meshes/ma_robot/base_link_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <link name="zed2_camera_link">
    <inertial>
      <origin xyz="0.000000 0.015505 0.042389" rpy="0 0 0"/>
      <mass value="0.178229"/>
      <inertia ixx="2.662726e-05" ixy="-3.215230e-09" ixz="-1.621734e-09"
               iyy="4.362977e-04" iyz="-2.967393e-09" izz="4.390806e-04"/>
