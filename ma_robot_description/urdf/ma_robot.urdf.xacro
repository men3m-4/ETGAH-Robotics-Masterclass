<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ma_robot">

  <!-- Materials -->
  <material name="Acetal_Resin_Black">
    <color rgba="0.098 0.098 0.098 1.0"/>
  </material>

  <material name="PA_11_Nylon_HP_11_30_with_EOS_P_396_3D_Printer">
    <color rgba="0.247 0.247 0.247 1.0"/>
  </material>

  <material name="Steel">
    <color rgba="0.627 0.627 0.627 1.0"/>
  </material>

  <!-- Assembly includes -->
  <xacro:include filename="$(find ma_robot_description)/urdf/assemblies/rear_left_wheel_link.urdf.xacro"/>
  <xacro:include filename="$(find ma_robot_description)/urdf/assemblies/front_left_wheel_link.urdf.xacro"/>
  <xacro:include filename="$(find ma_robot_description)/urdf/assemblies/front_right_wheel_link.urdf.xacro"/>
  <xacro:include filename="$(find ma_robot_description)/urdf/assemblies/rear_right_wheel_link.urdf.xacro"/>
  <xacro:include filename="$(find ma_robot_description)/urdf/assemblies/ma_robot.urdf.xacro"/>

  <!-- Gazebo configuration -->
  <xacro:include filename="$(find ma_robot_description)/urdf/ma_robot.gazebo.xacro"/>

  <!-- Instantiate assemblies -->
  <xacro:rear_left_wheel_link prefix=""/>
  <xacro:front_left_wheel_link prefix=""/>
  <xacro:front_right_wheel_link prefix=""/>
  <xacro:rear_right_wheel_link prefix=""/>
  <xacro:ma_robot prefix=""/>

  <!-- Wheel mount joints -->

  <!-- Front-left wheel -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>

    <origin
      xyz="0.130000 0.060000 0.020000"
      rpy="-1.570796 0.000000 0.000000"/>

    <axis xyz="0.000000 0.000000 1.000000"/>

    <limit effort="100.0" velocity="10.0"/>
  </joint>

  <!-- Front-right wheel -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>

    <origin
      xyz="0.130000 -0.185000 0.020000"
      rpy="1.570796 0.000000 0.000000"/>

    <!-- Reversed because the right wheel frame is mirrored -->
    <axis xyz="0.000000 0.000000 -1.000000"/>

    <limit effort="100.0" velocity="10.0"/>
  </joint>

  <!-- Rear-left wheel -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>

    <origin
      xyz="-0.020000 0.060000 0.020000"
      rpy="-1.570796 0.000000 0.000000"/>

    <axis xyz="0.000000 0.000000 1.000000"/>

    <limit effort="100.0" velocity="10.0"/>
  </joint>

  <!-- Rear-right wheel -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>

    <origin
      xyz="-0.020000 -0.187000 0.020000"
      rpy="1.570796 0.000000 0.000000"/>

    <!-- Reversed because the right wheel frame is mirrored -->
    <axis xyz="0.000000 0.000000 -1.000000"/>

    <limit effort="100.0" velocity="10.0"/>
  </joint>

  <!-- ROS 2 control -->
  <ros2_control name="ma_robot_system" type="system">

    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/ma_robot_system/cmd</param>
      <param name="state_topic">sim/ma_robot_system/state</param>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </ros2_control>

</robot>