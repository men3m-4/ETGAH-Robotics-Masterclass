<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="base_link_macro">

  <xacro:macro name="base_link" params="prefix">

    <!-- Links -->
    <link name="${prefix}zed2_camera_link">
      <inertial>
        <origin xyz="0.000000 0.015505 0.042389" rpy="0 0 0"/>
        <mass value="0.178229"/>
        <inertia ixx="2.662726e-05" ixy="-3.215230e-09" ixz="-1.621734e-09"
                 iyy="4.362977e-04" iyz="-2.967393e-09" izz="4.390806e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://ma_robot_description/meshes/base_link/zed2_camera_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="PA_11_Nylon_HP_11_30_with_EOS_P_396_3D_Printer"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://ma_robot_description/meshes/base_link/zed2_camera_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}rplidar_s2_link">
      <inertial>
        <origin xyz="-0.595013 0.532942 0.012880" rpy="0 0 0"/>
        <mass value="0.203764"/>
        <inertia ixx="1.351079e-04" ixy="-7.653496e-09" ixz="1.410544e-08"
                 iyy="1.362177e-04" iyz="3.930765e-08" izz="2.370283e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://ma_robot_description/meshes/base_link/rplidar_s2_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://ma_robot_description/meshes/base_link/rplidar_s2_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

  </xacro:macro>

</robot>