<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ma_robot_macro">

  <xacro:macro name="ma_robot" params="prefix">

    <!-- Links -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.041574 -0.062494 0.024420" rpy="0 0 0"/>
        <mass value="2.899152"/>
        <inertia ixx="7.973742e-03" ixy="9.036729e-07" ixz="2.781740e-04"
                 iyy="1.379462e-02" iyz="-4.481306e-07" izz="2.052761e-02"/>
      </inertial>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://ma_robot_description/meshes/ma_robot/base_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}zed2_camera_link">
      <inertial>
        <origin xyz="0.000000 0.015505 0.042389" rpy="0 0 0"/>
        <mass value="0.178229"/>
        <inertia ixx="2.662726e-05" ixy="-3.215230e-09" ixz="-1.621734e-09"
                 iyy="4.362977e-04" iyz="-2.967393e-09" izz="4.390806e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://ma_robot_description/meshes/ma_robot/zed2_camera_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="PA_11_Nylon_HP_11_30_with_EOS_P_396_3D_Printer"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://ma_robot_description/meshes/ma_robot/zed2_camera_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}rplidar_s2_link">
      <inertial>
        <origin xyz="-0.595013 0.532942 0.012880" rpy="0 0 0"/>
        <mass value="0.203764"/>
        <inertia ixx="1.351079e-04" ixy="-7.653496e-09" ixz="1.410544e-08"
                 iyy="1.362177e-04" iyz="3.930765e-08" izz="2.370283e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://ma_robot_description/meshes/ma_robot/rplidar_s2_link.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
        <geometry>
          <mesh filename="package://ma_robot_description/meshes/ma_robot/rplidar_s2_link_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <!-- Joints (internal to assembly) -->
    <joint name="${prefix}Rigid_1" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}zed2_camera_link"/>
      <origin xyz="0.145000 -0.062500 -0.007371" rpy="0.000000 0.000000 -1.570796"/>
    </joint>

    <joint name="${prefix}Rigid_2" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}rplidar_s2_link"/>
      <origin xyz="-0.433747 -0.657506 0.046815" rpy="0.000000 0.000000 -1.570796"/>
    </joint>

  </xacro:macro>

</robot>