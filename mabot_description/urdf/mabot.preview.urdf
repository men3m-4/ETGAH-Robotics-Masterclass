<!-- =================================================================================== -->
<robot name="mabot">
  <!-- Materials -->
  <material name="Acetal_Resin_Black">
    <color rgba="0.098 0.098 0.098 1.0"/>
  </material>
  <material name="PA_11_Nylon_HP_11_30_with_EOS_P_396_3D_Printer">
    <color rgba="0.247 0.247 0.247 1.0"/>
  </material>
  <material name="Steel">
    <color rgba="0.627 0.627 0.627 1.0"/>
  </material>
  <!-- Wheel contact properties -->
  <gazebo reference="front_left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>
  <!-- RPLIDAR S2 simulation -->
  <gazebo reference="rplidar_s2_link">
    <sensor name="rplidar_s2_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <gz_frame_id>rplidar_s2_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592</min_angle>
              <mesh filename="package://mabot_description/meshes/rear_left_wheel_link/rear_left_wheel_link.dae" scale="1 1 1"/>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- ZED2 RGB-D camera simulation -->
  <gazebo reference="zed2_camera_link">
    <sensor name="zed2_rgbd_sensor" type="rgbd_camera">
      <!--
              <mesh filename="package://mabot_description/meshes/front_left_wheel_link/front_left_wheel_link.dae" scale="1 1 1"/>
        now points forward with base_link +X.
      -->
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera</topic>
      <gz_frame_id>zed2_camera_link</gz_frame_id>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera name="zed2_camera">
        <horizontal_fov>1.92</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>20.0</far>
        </clip>
              <mesh filename="package://mabot_description/meshes/front_right_wheel_link/front_right_wheel_link.dae" scale="1 1 1"/>
          <clip>
            <near>0.20</near>
            <far>20.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
  <!-- Gazebo model systems -->
  <gazebo>
    <!-- Publish wheel joint states -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
    <!-- Four-wheel differential drive -->
              <mesh filename="package://mabot_description/meshes/rear_right_wheel_link/rear_right_wheel_link.dae" scale="1 1 1"/>
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.246</wheel_separation>
      <wheel_radius>0.045</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </gazebo>
  <link name="rear_left_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
              <mesh filename="package://mabot_description/meshes/ma_robot/base_link.dae" scale="1 1 1"/>
      <inertia ixx="5.265770e-04" ixy="-5.777757e-10" ixz="8.274260e-11" iyy="5.265750e-04" iyz="-6.033033e-11" izz="7.325315e-04"/>
    </inertial>
    <visual>
      <origin rpy="1.570796 0.000000 0.000000" xyz="-0.012900 -0.018051 0.005477"/>
      <geometry>
        <mesh filename="package://mabot_description/meshes/rear_left_wheel_link/rear_left_wheel_link.dae" scale="1 1 1"/>
              <mesh filename="package://mabot_description/meshes/ma_robot/base_link_collision.stl" scale="0.01 0.01 0.01"/>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.050" radius="0.045"/>
      </geometry>
    </collision>
  </link>
  <link name="front_left_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
              <mesh filename="package://mabot_description/meshes/ma_robot/zed2_camera_link.dae" scale="1 1 1"/>
      <inertia ixx="5.265770e-04" ixy="-5.777757e-10" ixz="-8.274260e-11" iyy="5.265750e-04" iyz="6.033033e-11" izz="7.325315e-04"/>
    </inertial>
    <visual>
      <origin rpy="1.570796 0.000000 3.141593" xyz="-0.107100 0.070499 -0.137841"/>
      <geometry>
        <mesh filename="package://mabot_description/meshes/front_left_wheel_link/front_left_wheel_link.dae" scale="1 1 1"/>
              <mesh filename="package://mabot_description/meshes/ma_robot/zed2_camera_link_collision.stl" scale="0.01 0.01 0.01"/>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.050" radius="0.045"/>
      </geometry>
    </collision>
  </link>
  <link name="front_right_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
              <mesh filename="package://mabot_description/meshes/ma_robot/rplidar_s2_link.dae" scale="1 1 1"/>
      <inertia ixx="5.265770e-04" ixy="-5.777757e-10" ixz="-8.274258e-11" iyy="5.265750e-04" iyz="6.033033e-11" izz="7.325315e-04"/>
    </inertial>
    <visual>
      <origin rpy="1.570796 0.000000 3.141593" xyz="0.179797 0.018051 0.124560"/>
      <geometry>
        <mesh filename="package://mabot_description/meshes/front_right_wheel_link/front_right_wheel_link.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
        <ros2_control name="mabot_system" type="system">
          <hardware>
            <plugin>mock_components/GenericSystem</plugin>
            <param name="cmd_topic">sim/mabot_system/cmd</param>
            <param name="state_topic">sim/mabot_system/state</param>
          </hardware>
  <link name="rear_right_wheel_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.611603"/>
      <inertia ixx="5.265770e-04" ixy="-5.777757e-10" ixz="8.274260e-11" iyy="5.265750e-04" iyz="-6.033033e-11" izz="7.325315e-04"/>
    </inertial>
    <visual>
      <origin rpy="1.570796 0.000000 0.000000" xyz="0.002378 -0.018051 -0.241816"/>
      <geometry>
        <mesh filename="package://mabot_description/meshes/rear_right_wheel_link/rear_right_wheel_link.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.050" radius="0.045"/>
      </geometry>
    </collision>
  </link>
  <!-- Base link -->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.041574 -0.062494 0.024420"/>
      <mass value="2.899172"/>
      <inertia ixx="7.973854e-03" ixy="9.036948e-07" ixz="2.783510e-04" iyy="1.379501e-02" iyz="-4.481462e-07" izz="2.052789e-02"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mabot_description/meshes/ma_robot/base_link.dae" scale="1 1 1"/>
      </geometry>
      <material name="Acetal_Resin_Black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mabot_description/meshes/ma_robot/base_link_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <!-- ZED2 camera -->
  <link name="zed2_camera_link">
    <!--
        Camera link frame points forward with base_link +X.
        The inertia transform preserves the original physical inertia.
      -->
    <inertial>
      <origin rpy="0.000000 0.000000 -1.570796" xyz="0.015505 0.000000 0.042389"/>
      <mass value="0.178229"/>
      <inertia ixx="2.662726e-05" ixy="-3.215230e-09" ixz="-1.621734e-09" iyy="4.362977e-04" iyz="-2.967393e-09" izz="4.390806e-04"/>
    </inertial>
    <!-- Keep the camera mesh in its original physical orientation -->
    <visual>
      <origin rpy="0.000000 0.000000 -1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mabot_description/meshes/ma_robot/zed2_camera_link.dae" scale="1 1 1"/>
      </geometry>
      <material name="PA_11_Nylon_HP_11_30_with_EOS_P_396_3D_Printer"/>
    </visual>
    <!-- Keep the collision mesh aligned with the visual mesh -->
    <collision>
      <origin rpy="0.000000 0.000000 -1.570796" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mabot_description/meshes/ma_robot/zed2_camera_link_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>
  <!-- RPLIDAR S2 -->
  <link name="rplidar_s2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.000007 -0.000076 -0.009381"/>
      <mass value="0.203764"/>
      <inertia ixx="1.351079e-04" ixy="-7.653496e-09" ixz="1.410544e-08" iyy="1.362177e-04" iyz="3.930765e-08" izz="2.370283e-04"/>
    </inertial>
    <!-- Offset removes the coordinates baked inside the DAE mesh -->
    <visual>
      <origin rpy="0 0 0" xyz="0.595006 -0.533018 -0.022261"/>
      <geometry>
        <mesh filename="package://mabot_description/meshes/ma_robot/rplidar_s2_link.dae" scale="1 1 1"/>
      </geometry>
      <material name="Steel"/>
    </visual>
    <!-- Simplified collision centered on the lidar frame -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.038851" radius="0.0385"/>
      </geometry>
    </collision>
  </link>
  <!--
      Camera frame points forward.

      Its yaw is now zero, so camera +X is aligned with base_link +X.
      The -90 degree visual rotation above keeps the camera model unchanged.
    -->
  <joint name="zed2_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed2_camera_link"/>
    <origin rpy="0.000000 0.000000 0.000000" xyz="0.145000 -0.062500 -0.007371"/>
  </joint>
  <!-- Lidar fixed joint -->
  <joint name="rplidar_s2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rplidar_s2_link"/>
    <origin rpy="0.000000 0.000000 -1.570796" xyz="0.099271 -0.062500 0.069076"/>
  </joint>
  <!-- Wheel mount joints -->
  <!-- Front-left wheel -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin rpy="-1.570796 0.000000 0.000000" xyz="0.130000 0.060000 0.020000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="10.0"/>
  </joint>
  <!-- Front-right wheel -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <origin rpy="1.570796 0.000000 0.000000" xyz="0.130000 -0.185000 0.020000"/>
    <!-- Reversed because the right wheel frame is mirrored -->
    <axis xyz="0.000000 0.000000 -1.000000"/>
    <limit effort="100.0" velocity="10.0"/>
  </joint>
  <!-- Rear-left wheel -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin rpy="-1.570796 0.000000 0.000000" xyz="-0.020000 0.060000 0.020000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="10.0"/>
  </joint>
  <!-- Rear-right wheel -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin rpy="1.570796 0.000000 0.000000" xyz="-0.020000 -0.187000 0.020000"/>
    <!-- Reversed because the right wheel frame is mirrored -->
    <axis xyz="0.000000 0.000000 -1.000000"/>
    <limit effort="100.0" velocity="10.0"/>
  </joint>
  <!-- ROS 2 control -->
  <ros2_control name="mabot_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/mabot_system/cmd</param>
      <param name="state_topic">sim/mabot_system/state</param>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
