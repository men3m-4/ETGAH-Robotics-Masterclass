<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="mabot_macro">

  <xacro:macro name="mabot" params="prefix">

    <!-- ================================================== -->
    <!-- Base footprint                                     -->
    <!-- ================================================== -->

    <!--
      Virtual ground-level frame used as the robot's
      kinematic reference.

      It intentionally has no visual, collision, mass,
      or inertia properties.
    -->
    <link name="${prefix}base_footprint"/>


    <!-- ================================================== -->
    <!-- Base link                                          -->
    <!-- ================================================== -->

    <link name="${prefix}base_link">

      <inertial>
        <origin
          xyz="0.041574 -0.062494 0.024420"
          rpy="0.000000 0.000000 0.000000"/>

        <mass value="2.899172"/>

        <inertia
          ixx="7.973854e-03"
          ixy="9.036948e-07"
          ixz="2.783510e-04"
          iyy="1.379501e-02"
          iyz="-4.481462e-07"
          izz="2.052789e-02"/>
      </inertial>

      <visual>
        <origin
          xyz="0.000000 0.000000 0.000000"
          rpy="0.000000 0.000000 0.000000"/>

        <geometry>
          <mesh
            filename="package://mabot_description/meshes/ma_robot/base_link.dae"
            scale="1 1 1"/>
        </geometry>

        <material name="Acetal_Resin_Black"/>
      </visual>

      <collision>
        <origin
          xyz="0.000000 0.000000 0.000000"
          rpy="0.000000 0.000000 0.000000"/>

        <geometry>
          <mesh
            filename="package://mabot_description/meshes/ma_robot/base_link_collision.stl"
            scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>

    </link>


    <!--
      The base_link CAD origin is offset from the kinematic
      center represented by base_footprint.

      X = -55.000 mm
      Y = +62.500 mm
      Z = +26.386 mm above the ground
    -->
    <joint name="${prefix}base_footprint_joint"
           type="fixed">

      <parent link="${prefix}base_footprint"/>
      <child link="${prefix}base_link"/>

      <origin
        xyz="-0.055000 0.062500 0.026386"
        rpy="0.000000 0.000000 0.000000"/>

    </joint>


    <!-- ================================================== -->
    <!-- ZED2 camera physical link                          -->
    <!-- ================================================== -->

    <link name="${prefix}zed2_camera_link">

      <!--
        zed2_camera_link uses the standard robot frame:
          +X forward
          +Y left
          +Z upward

        The inertia transform preserves the original
        physical inertia exported from Fusion 360.
      -->
      <inertial>
        <origin
          xyz="0.015505 0.000000 0.042389"
          rpy="0.000000 0.000000 -1.570796"/>

        <mass value="0.178229"/>

        <inertia
          ixx="2.662726e-05"
          ixy="-3.215230e-09"
          ixz="-1.621734e-09"
          iyy="4.362977e-04"
          iyz="-2.967393e-09"
          izz="4.390806e-04"/>
      </inertial>

      <!--
        Keep the camera mesh in its original physical
        mounting orientation.
      -->
      <visual>
        <origin
          xyz="0.000000 0.000000 0.000000"
          rpy="0.000000 0.000000 -1.570796"/>

        <geometry>
          <mesh
            filename="package://mabot_description/meshes/ma_robot/zed2_camera_link.dae"
            scale="1 1 1"/>
        </geometry>

        <material
          name="PA_11_Nylon_HP_11_30_with_EOS_P_396_3D_Printer"/>
      </visual>

      <!--
        Keep the collision mesh aligned with the
        visible camera mesh.
      -->
      <collision>
        <origin
          xyz="0.000000 0.000000 0.000000"
          rpy="0.000000 0.000000 -1.570796"/>

        <geometry>
          <mesh
            filename="package://mabot_description/meshes/ma_robot/zed2_camera_link_collision.stl"
            scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>

    </link>


    <!-- ================================================== -->
    <!-- ZED2 optical frame                                 -->
    <!-- ================================================== -->

    <!--
      ROS optical-frame convention:
        +Z points forward through the camera lens
        +X points to the right in the image
        +Y points downward in the image

      This is a virtual reference frame and therefore does
      not require visual, collision, mass or inertia.
    -->
    <link name="${prefix}zed2_camera_optical_link"/>


    <!-- ================================================== -->
    <!-- RPLIDAR S2                                         -->
    <!-- ================================================== -->

    <link name="${prefix}rplidar_s2_link">

      <!--
        The LiDAR link frame is aligned with base_link:
          +X forward
          +Y left
          +Z upward

        The inertial pose was transformed from the original
        Fusion frame so that the physical inertia remains
        unchanged after correcting the link orientation.
      -->
      <inertial>
        <origin
          xyz="-0.000076 0.000007 -0.009381"
          rpy="0.000000 0.000000 -1.570796"/>

        <mass value="0.203764"/>

        <inertia
          ixx="1.351079e-04"
          ixy="-7.653496e-09"
          ixz="1.410544e-08"
          iyy="1.362177e-04"
          iyz="3.930765e-08"
          izz="2.370283e-04"/>
      </inertial>

      <!--
        The COLLADA mesh contains coordinates baked relative
        to the original Fusion 360 assembly.

        This transformed translation and rotation preserve
        the original visible position while allowing the
        rplidar_s2_link frame to point forward.
      -->
      <visual>
        <origin
          xyz="-0.533018 -0.595006 -0.022261"
          rpy="0.000000 0.000000 -1.570796"/>

        <geometry>
          <mesh
            filename="package://mabot_description/meshes/ma_robot/rplidar_s2_link.dae"
            scale="1 1 1"/>
        </geometry>

        <material name="Steel"/>
      </visual>

      <!--
        Simplified cylindrical collision centered on the
        physical LiDAR frame.

        A yaw rotation is unnecessary because the cylinder
        is symmetric around its Z axis.
      -->
      <collision>
        <origin
          xyz="0.000000 0.000000 0.000000"
          rpy="0.000000 0.000000 0.000000"/>

        <geometry>
          <cylinder
            radius="0.0385"
            length="0.038851"/>
        </geometry>
      </collision>

    </link>


    <!-- ================================================== -->
    <!-- Camera joints                                      -->
    <!-- ================================================== -->

    <!--
      Camera physical frame aligned with the robot's
      forward +X direction.
    -->
    <joint name="${prefix}zed2_camera_joint"
           type="fixed">

      <parent link="${prefix}base_link"/>
      <child link="${prefix}zed2_camera_link"/>

      <origin
        xyz="0.145000 -0.062500 -0.007371"
        rpy="0.000000 0.000000 0.000000"/>

    </joint>


    <!--
      Fixed transform from the physical camera frame to the
      standard ROS optical camera frame.
    -->
    <joint name="${prefix}zed2_camera_optical_joint"
           type="fixed">

      <parent link="${prefix}zed2_camera_link"/>
      <child link="${prefix}zed2_camera_optical_link"/>

      <origin
        xyz="0.000000 0.000000 0.000000"
        rpy="-1.570796 0.000000 -1.570796"/>

    </joint>


    <!-- ================================================== -->
    <!-- LiDAR joint                                        -->
    <!-- ================================================== -->

    <!--
      The LiDAR frame is located at the physical sensor
      center and aligned with the robot:

        +X forward
        +Y left
        +Z upward

      This alignment allows LaserScan angle 0 to represent
      the front of MABot correctly.
    -->
    <joint name="${prefix}rplidar_s2_joint"
           type="fixed">

      <parent link="${prefix}base_link"/>
      <child link="${prefix}rplidar_s2_link"/>

      <origin
        xyz="0.099271 -0.062500 0.069076"
        rpy="0.000000 0.000000 0.000000"/>

    </joint>

  </xacro:macro>

</robot>